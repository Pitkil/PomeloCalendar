{
  "version": "2.0",
  "envId": "cloud1-d4gevz3o6da314ea9",
  "framework": {
    "name": "swu-campus-calendar",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "swu-calendar-auth",
          "servicePath": "/",
          "localPath": "./",
          "containerPort": 8787,
          "isPublic": true,
          "mode": "low-cost",
          "cpu": 0.25,
          "mem": 0.5,
          "minNum": 0,
          "maxNum": 2,
          "envVariables": {
            "HOST": "0.0.0.0",
            "PORT": "8787",
            "REQUEST_TIMEOUT_MS": "20000",
            "RATE_LIMIT_MAX": "8",
            "RATE_LIMIT_WINDOW_MS": "600000",
            "CORS_ORIGIN": "*"
          }
        }
      }
    }
  }
}
