<view class="page wallpaper-{{settings.wallpaper}}" style="--accent: {{settings.accent}}; --panel-alpha: {{panelAlpha}}; {{wallpaperStyle}}">
  <view class="veil"></view>

  <view class="shell">
    <view class="hero">
      <view class="brand-row">
        <view class="brand-copy">
          <view class="eyebrow">SWU CAMPUS CALENDAR</view>
          <view class="brand">西柚日历</view>
          <view class="semester-line">{{settings.semesterTitle}} · {{teachingWeek ? '第' + teachingWeek + '教学周' : '假期 / 未排课'}}</view>
        </view>
        <view class="hero-actions">
          <view class="icon-button" bindtap="openSync" role="button" aria-label="同步课表">↻</view>
          <view class="icon-button" bindtap="openSettings" role="button" aria-label="设置">⚙</view>
        </view>
      </view>

      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input value="{{query}}" bindinput="onSearchInput" placeholder="搜索课程、教室或日程" confirm-type="search" />
        <text wx:if="{{query}}" class="search-clear" bindtap="clearSearch">×</text>
      </view>

      <view class="quick-stats">
        <view class="stat"><text class="stat-value">{{stats.todayCount}}</text><text>今日安排</text></view>
        <view class="stat"><text class="stat-value">{{stats.completed}}</text><text>已完成</text></view>
        <view class="stat tomato"><text class="stat-value">{{stats.focusMinutes}}</text><text>专注分钟</text></view>
      </view>
    </view>

    <view wx:if="{{query}}" class="search-panel paper-card">
      <view class="section-heading">
        <text>搜索结果</text>
        <text class="muted">{{searchResults.length}} 项</text>
      </view>
      <view wx:if="{{!searchResults.length}}" class="empty-small">没有找到相关安排</view>
      <view wx:for="{{searchResults}}" wx:key="id" class="compact-result" data-key="{{item.date}}" bindtap="selectDate">
        <view class="result-dot" style="background:{{item.color}}"></view>
        <view class="result-main"><text>{{item.title}}</text><text class="muted">{{item.date}} · {{item.startTime}} · {{item.location || item.category}}</text></view>
      </view>
    </view>

    <view class="mode-switch paper-card">
      <view class="mode {{viewMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchView">月历</view>
      <view class="mode {{viewMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="switchView">周课表</view>
      <view class="mode {{viewMode === 'focus' ? 'active tomato-active' : ''}}" data-mode="focus" bindtap="switchView">番茄钟</view>
      <view class="mode {{viewMode === 'accounting' ? 'active' : ''}}" data-mode="accounting" bindtap="switchView">记账</view>
    </view>

    <view wx:if="{{viewMode === 'month'}}" class="calendar paper-card">
      <view class="calendar-head">
        <view class="nav-button" bindtap="previousMonth" role="button" aria-label="上个月">‹</view>
        <view>
          <view class="month-title">{{monthTitle}}</view>
          <view class="muted small">轻点日期查看当天安排</view>
        </view>
        <view class="today-button" bindtap="goToday" role="button">今天</view>
        <view class="nav-button" bindtap="nextMonth" role="button" aria-label="下个月">›</view>
      </view>

      <view class="weekday-row">
        <text class="week-corner">周</text>
        <text wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</text>
      </view>

      <view wx:for="{{calendarRows}}" wx:key="index" wx:for-item="row" class="calendar-row">
        <view class="week-number">{{row.week || '·'}}</view>
        <view
          wx:for="{{row.days}}"
          wx:key="key"
          wx:for-item="day"
          class="day {{day.muted ? 'muted-day' : ''}} {{day.today ? 'today' : ''}} {{day.selected ? 'selected' : ''}}"
          data-key="{{day.key}}"
          bindtap="selectDate"
        >
          <text class="day-number">{{day.day}}</text>
          <view class="event-dots">
            <view wx:for="{{day.dots}}" wx:key="index" wx:for-item="dot" class="event-dot" style="background:{{dot}}"></view>
          </view>
          <text wx:if="{{day.eventCount > 3}}" class="more-count">+{{day.eventCount - 3}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{viewMode === 'week'}}" class="week-board paper-card">
      <view class="section-heading">
        <view>
          <text class="month-title">本周课表</text>
          <text class="muted small">第 {{teachingWeek || '—'}} 教学周</text>
        </view>
        <view class="today-button" bindtap="goToday" role="button">回到今天</view>
      </view>
      <scroll-view scroll-x="true" class="week-scroll" enhanced="true" show-scrollbar="false">
        <view class="week-columns">
          <view wx:for="{{weekDays}}" wx:key="key" class="week-column {{item.today ? 'week-today' : ''}}" data-key="{{item.key}}" bindtap="selectDate">
            <view class="week-column-head"><text>周{{item.weekday}}</text><text>{{item.label}}</text></view>
            <view wx:if="{{!item.events.length}}" class="free-slot">空闲</view>
            <view wx:for="{{item.events}}" wx:key="id" class="mini-event" style="border-color:{{item.color}}" catchtap="openEvent" data-id="{{item.id}}">
              <text class="mini-time">{{item.startTime}}</text>
              <text class="mini-title">{{item.title}}</text>
              <text class="mini-place">{{item.location}}</text>
            </view>
            <view wx:if="{{item.moreCount}}" class="week-more">+{{item.moreCount}} 门课程</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{viewMode === 'focus'}}" class="focus-card paper-card">
      <view class="focus-orbit">
        <view class="focus-ring">
          <text class="focus-kicker">{{focus.mode === 'focus' ? '专注中' : '休息一下'}}</text>
          <text class="focus-time">{{focus.display}}</text>
          <text class="focus-round">今日第 {{focus.roundsToday + 1}} 轮</text>
        </view>
      </view>
      <view class="focus-mode-row">
        <view class="focus-chip {{focus.mode === 'focus' ? 'active' : ''}}" data-mode="focus" bindtap="switchFocusMode">专注 {{settings.focusMinutes}} 分钟</view>
        <view class="focus-chip {{focus.mode === 'break' ? 'active' : ''}}" data-mode="break" bindtap="switchFocusMode">休息 {{settings.breakMinutes}} 分钟</view>
      </view>
      <input class="focus-task" value="{{focus.taskTitle}}" bindinput="onFocusTaskInput" placeholder="这次想专注完成什么？" />
      <view class="focus-actions">
        <view class="secondary-button" bindtap="resetTimer" role="button">重置</view>
        <view class="primary-button tomato-button" bindtap="toggleTimer" role="button">{{focus.running ? '暂停' : '开始专注'}}</view>
      </view>
      <view class="focus-note">完成后会自动生成一条专注记录，出现在今天的日历中。</view>
    </view>

    <view wx:if="{{viewMode === 'accounting'}}" class="accounting-card paper-card">
      <view class="section-heading"><view><text class="month-title">校园记账</text><text class="muted small">本月收支一目了然</text></view><view class="add-inline" bindtap="openAccount">＋ 记一笔</view></view>
      <view class="money-row"><view><text class="muted small">支出</text><text class="money expense">{{monthExpense}}</text></view><view><text class="muted small">收入</text><text class="money income">{{monthIncome}}</text></view><view><text class="muted small">结余</text><text class="money">{{monthBalance}}</text></view></view>
      <view class="category-stat-list"><view wx:for="{{categoryStats}}" wx:key="name" class="category-stat"><view><text>{{item.name}}</text><text>¥{{item.amount}}</text></view><view class="stat-bar"><view style="width:{{item.percent}}%"></view></view></view></view>
      <view wx:if="{{!categoryStats.length && !monthAccounts.length}}" class="empty-state"><view class="empty-title">还没有账目</view><view class="muted">点击“记一笔”开始记录。</view></view>
      <view wx:for="{{monthAccounts}}" wx:key="id" class="ledger-row" data-id="{{item.id}}" bindtap="openAccount"><view class="ledger-mark {{item.type}}">{{item.type === 'income' ? '↑' : '↓'}}</view><view><text>{{item.category}}</text><text class="muted small">{{item.date}}{{item.note ? ' · ' + item.note : ''}}</text></view><text class="ledger-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}</text></view>
    </view>

    <view wx:if="{{viewMode !== 'focus'}}" class="agenda paper-card">
      <view class="section-heading">
        <view>
          <view class="month-title">{{selectedLabel}}</view>
          <view class="muted small">{{teachingWeek ? '第' + teachingWeek + '教学周' : '假期 / 未排课'}}</view>
        </view>
        <view class="add-inline" bindtap="openAdd" role="button">＋ 新增</view>
      </view>

      <view wx:if="{{!selectedEvents.length}}" class="empty-state">
        <view class="empty-sun">☀</view>
        <view class="empty-title">今天还没有安排</view>
        <view class="muted">给自己留白，或者添加一件想完成的事。</view>
      </view>

      <view wx:for="{{selectedEvents}}" wx:key="id" class="event-card {{item.completed ? 'event-done' : ''}}" style="--event-color:{{item.color}}">
        <view class="time-column"><text>{{item.startTime}}</text><text class="muted">{{item.endTime}}</text></view>
        <view class="event-line"></view>
        <view class="event-content" data-id="{{item.id}}" bindtap="openEvent">
          <view class="event-title-row">
            <text class="event-title">{{item.title}}</text>
            <text class="source-tag">{{item.source === 'course' ? '教务' : item.source === 'focus' ? '专注' : item.category}}</text>
          </view>
          <text wx:if="{{item.location}}" class="event-meta">⌖ {{item.location}}</text>
          <text wx:if="{{item.teacher}}" class="event-meta">{{item.teacher}}</text>
          <text wx:if="{{item.notes}}" class="event-notes">{{item.notes}}</text>
        </view>
        <view wx:if="{{item.source !== 'course'}}" class="check-button {{item.completed ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleComplete">{{item.completed ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="footer-note">{{syncStatus}} · 课表、日程与账目仅保存在本机</view>
  </view>

  <view wx:if="{{viewMode !== 'focus'}}" class="fab" bindtap="openAdd" role="button" aria-label="新增日程">＋</view>

  <view wx:if="{{editorVisible}}" class="modal-mask" bindtap="closeEditor">
    <view class="bottom-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">{{editingId ? '编辑日程' : '新增日程'}}</view>
      <label class="field"><text>日程名称</text><input value="{{form.title}}" data-field="title" bindinput="onFormInput" placeholder="例如：完成软件工程实验" /></label>
      <view class="two-fields">
        <label class="field"><text>日期</text><picker mode="date" value="{{form.date}}" bindchange="onDateChange"><view class="picker-field">{{form.date}}</view></picker></label>
        <label class="field"><text>分类</text><picker value="{{form.categoryIndex}}" range="{{categories}}" bindchange="onCategoryChange"><view class="picker-field">{{categories[form.categoryIndex]}}</view></picker></label>
      </view>
      <view class="two-fields">
        <label class="field"><text>开始</text><picker mode="time" value="{{form.startTime}}" bindchange="onStartTimeChange"><view class="picker-field">{{form.startTime}}</view></picker></label>
        <label class="field"><text>结束</text><picker mode="time" value="{{form.endTime}}" bindchange="onEndTimeChange"><view class="picker-field">{{form.endTime}}</view></picker></label>
      </view>
      <label class="field"><text>地点</text><input value="{{form.location}}" data-field="location" bindinput="onFormInput" placeholder="教室、图书馆或线上" /></label>
      <label class="field"><text>教师（可选）</text><input value="{{form.teacher}}" data-field="teacher" bindinput="onFormInput" placeholder="例如：张老师" /></label>
      <label class="field"><text>备注</text><textarea value="{{form.notes}}" data-field="notes" bindinput="onFormInput" placeholder="补充说明、待办事项……" /></label>
      <view class="sheet-actions">
        <view wx:if="{{editingId}}" class="danger-button" bindtap="deleteEvent" role="button">删除</view>
        <view class="secondary-button" bindtap="closeEditor" role="button">取消</view>
        <view class="primary-button" bindtap="saveEvent" role="button">保存日程</view>
      </view>
    </view>
  </view>

  <view wx:if="{{settingsVisible}}" class="modal-mask" bindtap="closeSettings">
    <scroll-view scroll-y="true" class="bottom-sheet settings-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">日历设置</view>
      <label class="field"><text>学期名称</text><input value="{{settings.semesterTitle}}" data-field="semesterTitle" bindinput="onSettingsInput" /></label>
      <view class="two-fields">
        <label class="field"><text>学期开始</text><picker mode="date" value="{{settings.semesterStart}}" bindchange="onSemesterStartChange"><view class="picker-field">{{settings.semesterStart}}</view></picker></label>
        <label class="field"><text>学期结束</text><picker mode="date" value="{{settings.semesterEnd}}" bindchange="onSemesterEndChange"><view class="picker-field">{{settings.semesterEnd}}</view></picker></label>
      </view>
      <view class="three-fields">
        <label class="field"><text>教学周</text><input type="number" value="{{settings.totalWeeks}}" data-field="totalWeeks" bindinput="onSettingsInput" /></label>
        <label class="field"><text>专注</text><input type="number" value="{{settings.focusMinutes}}" data-field="focusMinutes" bindinput="onSettingsInput" /></label>
        <label class="field"><text>休息</text><input type="number" value="{{settings.breakMinutes}}" data-field="breakMinutes" bindinput="onSettingsInput" /></label>
      </view>
      <view class="privacy-tip">专注和休息时长可以分别自定义，保存后计时器立即按新时长重置。</view>
      <view class="two-fields">
        <label class="field"><text>主题色</text><picker range="{{accentOptions}}" range-key="name" bindchange="onAccentChange"><view class="picker-field">点击选择</view></picker></label>
        <label class="field"><text>预设壁纸</text><picker range="{{wallpaperOptions}}" range-key="name" bindchange="onWallpaperChange"><view class="picker-field">点击选择</view></picker></label>
      </view>
      <label class="field"><text>卡片透明度（70-100）</text><input type="number" value="{{settings.cardOpacity}}" data-field="cardOpacity" bindinput="onSettingsInput" /></label>
      <view class="upload-button" bindtap="chooseWallpaper" role="button">＋ 从相册选择自定义壁纸</view>
      <view class="privacy-tip">课表通过文件导入，所有日历与账目数据仅保存在本机。</view>
      <view class="sheet-actions"><view class="secondary-button" bindtap="closeSettings" role="button">取消</view><view class="primary-button" bindtap="saveSettings" role="button">保存设置</view></view>
    </scroll-view>
  </view>

  <view wx:if="{{syncVisible}}" class="modal-mask" bindtap="closeSync">
    <view class="bottom-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">导入课表</view>
      <view class="privacy-tip strong">先打开西大办事大厅，进入“教务系统/我的课表”并导出 PDF。小程序请用 WPS 复制 PDF 表格后粘贴，或另存为 CSV 再选择文件；解析完全在本机完成。</view>
      <view class="upload-button" bindtap="chooseScheduleFile" role="button">＋ 选择 PDF / CSV / JSON / TXT 课表文件</view>
      <textarea class="import-textarea" placeholder="也可以粘贴表格文本：课程名称,教师,星期,节次,周次,教室" data-field="scheduleText" bindinput="onScheduleTextInput"></textarea>
      <view class="manual-login-link" bindtap="openJw" role="button">↗ 复制办事大厅网址</view>
      <view class="upload-button" bindtap="importDemoCourses" role="button">先导入示例课表体验</view>
      <view class="sheet-actions"><view class="secondary-button" bindtap="closeSync" role="button">取消</view><view class="primary-button" bindtap="importPastedSchedule" role="button">导入到日历</view></view>
    </view>
  </view>

  <view wx:if="{{accountingVisible}}" class="modal-mask" bindtap="closeAccount"><view class="bottom-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title">{{accountEditingId ? '编辑账目' : '记一笔'}}</view><view class="two-fields"><label class="field"><text>类型</text><picker range="{{accountTypeOptions}}" bindchange="onAccountTypeChange"><view class="picker-field">{{accountForm.type === 'income' ? '收入' : '支出'}}</view></picker></label><label class="field"><text>金额</text><input type="digit" value="{{accountForm.amount}}" data-field="amount" bindinput="onAccountInput" placeholder="0.00" /></label></view><view class="two-fields"><label class="field"><text>分类</text><picker range="{{accountCategories}}" value="{{accountForm.categoryIndex}}" bindchange="onAccountCategoryChange"><view class="picker-field">{{accountCategories[accountForm.categoryIndex]}}</view></picker></label><label class="field"><text>日期</text><picker mode="date" value="{{accountForm.date}}" bindchange="onAccountDateChange"><view class="picker-field">{{accountForm.date}}</view></picker></label></view><label class="field"><text>备注</text><input value="{{accountForm.note}}" data-field="note" bindinput="onAccountInput" placeholder="例如：食堂午餐" /></label><view class="sheet-actions"><view wx:if="{{accountEditingId}}" class="danger-button" bindtap="deleteAccount">删除</view><view class="secondary-button" bindtap="closeAccount">取消</view><view class="primary-button" bindtap="saveAccount">保存</view></view></view></view>
</view>
